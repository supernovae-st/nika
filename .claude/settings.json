{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/nika-health-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "echo '🏴‍☠️ ARMADA Active | 10 Stations | Version Lock: 0.x.x Forever | /armada to check'",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-load-spec.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-alignment.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "pattern": "\\.nika\\.yaml$|examples/.*\\.yaml$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/yaml-validate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "pattern": "Cargo\\.toml$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/version-lock-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-git-commit.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "pattern": "git\\s+(push|tag).*v[1-9]",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🚫 BLOCKED: Cannot push/tag version ≥1.0.0 - Nika uses 0.x.x forever' && exit 1",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash",
        "pattern": "git\\s+push\\s+(origin\\s+)?main(\\s|$)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🚫 BLOCKED: Direct push to main not allowed (branch protected)' && echo '💡 Use /ship to automatically create branch → PR → merge' && echo '   Or manually: git checkout -b feat/xxx && git push -u origin feat/xxx && gh pr create' && exit 1",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
