# Rust build artifacts
/target/
**/target/
Cargo.lock.bak
*.rs.bk

# Editors / OS cruft
.DS_Store
*.swp
*~
.vscode/*
!.vscode/extensions.json

# Local runtime state (main branch runtime, unrelated to diamond source)
/.nika/

# Local env files (secrets never in repo — use nika-vault)
.env
.env.local

# Snapshot temp files (cargo-insta)
*.pending-snap

# MCP server config (local, not in repo)
.mcp.json

# Legacy content from main (untracked on nika-diamond, present on disk)
# These dirs exist because the worktree carries them from main
# but they are NOT part of the diamond workspace.
/dx
/editors/

# Claude Code local settings (per-user, not shared)
.claude/settings.local.json
CLAUDE.local.md
