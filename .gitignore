# Rust build artifacts
/target/
**/target/
Cargo.lock.bak
*.rs.bk

# Editors / OS cruft
.DS_Store
*.swp
*~
.vscode/*
!.vscode/extensions.json

# Runtime state (nika serve traces, db, media cache)
/.nika/
**/tools/.nika/

# Local env files (secrets never in repo — use nika-vault)
.env
.env.local

# Snapshot temp files (cargo-insta)
*.pending-snap

# MCP server config (local, not in repo)
.mcp.json

# Legacy content from main (untracked on nika-diamond, present on disk)
# These dirs exist because the worktree carries them from main
# but they are NOT part of the diamond workspace.
/dx
/editors/
/tools/nika-core/
/tools/nika-engine/
/tools/nika-lsp-core/
/tools/nika/

# Mutation testing output
mutants.out/
mutants.out.old/

# Ad-hoc docs/research (private content belongs in supernovae/docs/)
/docs/research/
/docs/reports/

# Claude Code local settings (per-user, not shared)
.claude/settings.local.json
CLAUDE.local.md
