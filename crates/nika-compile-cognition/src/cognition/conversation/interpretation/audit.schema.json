{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "covered",
        "defect",
        "unknown"
      ]
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "missing",
              "invented",
              "changed",
              "scope"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "kind",
          "evidence",
          "note"
        ]
      }
    }
  },
  "required": [
    "status",
    "defects"
  ]
}
