{
  "compile_version": 1,
  "about": "Identical Compile requests for every door. `native` is the recipe for the core and the CLI (answers are [key, literal text] exactly as `--answer KEY=LITERAL` passes them). `http_body` is the verbatim POST /v1/compile body; @@SOURCE:name@@ stands for the JSON-encoded source. `expect` holds only facts the foundation suite already proves; an empty `expect` means door-versus-core equality is the whole claim.",
  "sources": {
    "policy": "nika: policy\nconst:\n  cap: {type: integer, value: 500}\n  region: France\npermits: {tools: ['nika:jq']}\ntasks:\n  cap:\n    invoke:\n      tool: nika:jq\n      args: {input: '${{ const.cap }}', expression: '.'}\n",
    "literal": "nika: literal-edit\nconst: {payload: 0}\npermits: {tools: ['nika:jq']}\ntasks:\n  echo:\n    invoke:\n      tool: nika:jq\n      args: {input: '${{ const.payload }}', expression: '.'}\n",
    "invalid": "nika: invalid\nconst: {x: 1}\ntasks:\n  effect:\n    exec: {command: [sh, -c, 'echo unsafe']}\n",
    "malformed": "nika: [bad",
    "mcp_preview": "nika: mcp-preview\nconst: {payload: original}\npermits: {tools: [\"mcp:unconfigured/send\"]}\ntasks:\n  remote:\n    invoke:\n      tool: mcp:unconfigured/send\n      args: {input: \"${{ const.payload }}\"}\n"
  },
  "cases": [
    {
      "name": "ready_hello",
      "doors": [
        "core",
