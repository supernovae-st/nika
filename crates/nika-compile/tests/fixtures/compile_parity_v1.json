      "http_body": "{\"compile_version\":1,\"mode\":\"create\",\"intent\":\"hello\"}",
      "expect": {
        "status": "ready",
        "candidate": "present",
        "skeleton": "hello",
        "question_keys": [],
        "preview": "present"
      }
