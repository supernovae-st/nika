nika: p12-exec-structured
permits: { exec: ["false"], tools: ["nika:log"] }
tasks:
  probe:
    exec: { command: ["false"], capture: structured }
  report:
    with: { code: "${{ tasks.probe.output.exit_code }}" }
    when: "${{ with.code != 0 }}"
    invoke: { tool: "nika:log", args: { message: "probe failed with ${{ with.code }}" } }
outputs:
  code: ${{ tasks.probe.output }}
