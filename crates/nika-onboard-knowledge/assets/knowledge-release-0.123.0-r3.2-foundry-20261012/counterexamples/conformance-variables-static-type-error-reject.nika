# Expected: NIKA-VAR-005 at CHECK.
nika: e20-var-type-error
# INTENT (corrected): a bare non-boolean-shaped when: root is rejected STATICALLY (spec 03 §when shape rules) → NIKA-VAR-005 at check, never reaches runtime VAR-006.
# when: ${{ const.count }} is a bare ref - should be NIKA-VAR-005 at parse time
const:
  count: 5
tasks:
  step:
    exec:
      command: ["echo", "hello"]
  conditional:
    after:
      step: success
    when: ${{ const.count }}
    exec:
      command: ["echo", "should", "not", "reach"]
