{"callables":["nika:assert","nika:decide"],"check_receipt":{"codes":[],"sha256":"19853dafb17ebee1841f23658cfa3448423713255083ab61f7a7611d5185f59e","spec_sha":"34ad76c5376ab6b1fb02e3e4c455ff23f1c1312c","verdict":"CURRENT_CHECKED","verifier_sha256":"33beb7ab3efda75ecf5cada95ee97b7ff74269abbf6d8c387831f6bca8f207e6"},"constructs":["const","invoke","invoke.tool","outputs","permits","permits.tools","with"],"corpus":"nika-pack-foundation@34ad76c5376a","exposure":"EXPOSED","facets":{},"file":"examples/pack-14-decide-publish.nika","file_sha256":"19853dafb17ebee1841f23658cfa3448423713255083ab61f7a7611d5185f59e","id":"example:pack:14-decide-publish","intent":"Decide, then publish or abstain — the kernel, never the model. 13 taught jq-as-law on integer facts. This file is the same law with a named Decision Bundle (spec 11). `nika:decide` is PURE compute: an inline bundle needs no filesystem. The model is not in this file.","kind":"example","language":"en","pin":{"binary":"nika 0.123.0-preview.1 (90d2472cd)","spec_sha":"34ad76c5376ab6b1fb02e3e4c455ff23f1c1312c"},"proof_level":"CHECKED","provenance":{"activity":"foundry.spec.pack_examples","created_at":"2026-10-11T22:18:28Z","model":null,"sources":["src:pack:90d2472cd"]},"sha256":"0f6d7f4400614d2c75ea47908bd5e5a1e2b3e0c2f77f534b302f2f203f2d58e7","split":"DEV","status":"EXAMPLE","title":"Decide, then publish or abstain — the kernel, never the model.","topology":"linear","trust":"imported"}
{"callables":["nika:compose","nika:done"],"check_receipt":{"codes":[],"sha256":"e0ffb364460f839a08efb108af0898a2e8fe13083e69da88727e5009fd08ab93","spec_sha":"34ad76c5376ab6b1fb02e3e4c455ff23f1c1312c","verdict":"CURRENT_CHECKED","verifier_sha256":"33beb7ab3efda75ecf5cada95ee97b7ff74269abbf6d8c387831f6bca8f207e6"},"constructs":["agent","agent.tools","model","outputs","permits","permits.tools"],"corpus":"nika-pack-foundation@34ad76c5376a","exposure":"EXPOSED","facets":{},"file":"examples/pack-15-compose-self-check.nika","file_sha256":"e0ffb364460f839a08efb108af0898a2e8fe13083e69da88727e5009fd08ab93","id":"example:pack:15-compose-self-check","intent":"Compose self-check — the loop checks the draft, never runs it. 10 taught parent→child composition (`invoke: { workflow: }`). This file is the other compose: `nika:compose` inside an `agent:` whitelist (ADR-096). The model drafts a nine-key workflow as YAML, gets the in-memory Core report back as JSON, repairs until `valid`, then calls `nika:done`. Child files are not resolved here: check the saved draft and its children before running. Checking never executes the draft (« generation is not permission »).","kind":"example","language":"en","pin":{"binary":"nika 0.123.0-preview.1 (90d2472cd)","spec_sha":"34ad76c5376ab6b1fb02e3e4c455ff23f1c1312c"},"proof_level":"CHECKED","provenance":{"activity":"foundry.spec.pack_examples","created_at":"2026-10-11T22:18:28Z","model":null,"sources":["src:pack:90d2472cd"]},"sha256":"6122e8aa1d6b7c26fd3d14ce1d3324fb5b98e9c0bf4780cd0fccbf5ac715709d","split":"DEV","status":"EXAMPLE","title":"Compose self-check — the loop checks the draft, never runs it.","topology":"agentic","trust":"imported"}
