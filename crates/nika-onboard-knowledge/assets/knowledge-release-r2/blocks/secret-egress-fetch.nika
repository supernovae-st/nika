nika: p04-secrets-egress
secrets:
  api_key:
    source: env
    key: EXAMPLE_API_KEY
    egress:
      - to: "nika:fetch"
        host: "api.example.com"
      - to: "outputs"
permits:
  tools: ["nika:fetch"]
  net: { http: ["api.example.com"] }
tasks:
  call:
    invoke:
      tool: "nika:fetch"
      args:
        url: "https://api.example.com/v1/items"
        headers: { authorization: "Bearer ${{ secrets.api_key }}" }
        mode: jq
        jq: "."
outputs:
  items: ${{ tasks.call.output }}
