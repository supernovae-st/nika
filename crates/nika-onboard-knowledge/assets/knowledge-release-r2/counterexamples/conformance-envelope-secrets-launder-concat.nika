# Expected: check-reject (gate verdict). SECRETS: concat-laundered secret still reaches a sink.
# Secret laundered through jq concat then exec (tainted-output leak).
nika: sec20-secret-launder-concat

secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST

permits:
  exec: true
  tools: ["nika:jq"]

tasks:
  launder:
    invoke:
      tool: nika:jq
      args:
        input: "prefix_"
        expression: ". + \"${{ secrets.api_key }}\""

  attack_exec:
    with:
      launder: ${{ tasks.launder.output }}
    exec:
      command: ["echo", "${{ with.launder }}"]
