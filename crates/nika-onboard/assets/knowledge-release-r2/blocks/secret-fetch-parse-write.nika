nika: p55-secret-fetch-parse-write
model: mock/echo
secrets:
  api_key:
    source: env
    key: EXAMPLE_API_KEY
    egress:
      - to: "nika:fetch"
        host: "api.example.com"
      - to: "nika:jq"
      - to: "nika:write"
      - to: "outputs"
permits:
  fs: { write: ["./out/sales.json"] }
  tools: ["nika:fetch", "nika:jq", "nika:write"]
  net: { http: ["api.example.com"] }
tasks:
  fetch_sales:
    invoke:
      tool: "nika:fetch"
      args:
        url: "https://api.example.com/v1/sales"
        headers: { authorization: "Bearer ${{ secrets.api_key }}" }
        mode: raw
    on_error: { recover: "{\"sales\": [{\"id\": 1, \"amount\": 10}]}" }
  parse_sales:
    with: { raw: "${{ tasks.fetch_sales.output }}" }
    invoke:
      tool: "nika:jq"
      args: { input: "${{ with.raw }}", expression: "fromjson | .sales | length" }
  save:
    with: { count: "${{ tasks.parse_sales.output }}" }
    invoke:
      tool: "nika:write"
      args: { path: "./out/sales.json", content: "${{ with.count }}" }
outputs:
  count: ${{ tasks.parse_sales.output }}
