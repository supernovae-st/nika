# Expected: NIKA-SEC-007 at CHECK. An outputs: entry that reads the secret itself is refused even with an output egress rule (spec 01 §egress: the rule declassifies a derived value, never the secret's own value).
# The third member of the output-egress set: the refusal pair proves the wall,
# the sanctioned twin opens it for a derived value only, and this case keeps it
# shut for the secret's own bytes. The harmless task keeps the workflow valid.
nika: secrets-direct-output-egress-refused

secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST
    egress:
      - { to: "outputs" }

tasks:
  noop:
    invoke:
      tool: "nika:jq"
      args: { input: "ready", expression: "." }

outputs:
  exported: "${{ secrets.api_key }}"
