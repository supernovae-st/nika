# Nika Serve environment — copy to ~/.nika/.env
# Required
NIKA_SERVE_TOKEN=<generate with: openssl rand -hex 32>

# API keys (at least one required for LLM workflows)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=...
# XAI_API_KEY=xai-...

# Optional overrides
# NIKA_SERVE_BIND=0.0.0.0:3000
# NIKA_SERVE_MAX_CONCURRENT=6
# NIKA_SERVE_TIMEOUT=300
# NIKA_VAULT_PASSPHRASE=...
