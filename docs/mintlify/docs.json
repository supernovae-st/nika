{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Nika",
  "description": "Documentation for Nika — the AGPL workflow engine for AI. Semantic YAML, Rust, runs on your laptop.",
  "theme": "mint",
  "logo": {
    "dark": "/images/logo-dark.svg",
    "light": "/images/logo-light.svg",
    "href": "https://nika.sh"
  },
  "favicon": "/images/favicon.svg",
  "colors": {
    "primary": "#FF6B1A",
    "light": "#F5C28B",
    "dark": "#FF6B1A"
  },
  "customCss": "/global.css",
  "modeToggle": { "default": "dark", "isHidden": true },
  "appearance": { "default": "dark" },
  "background": {
    "color": { "dark": "#0B0D17", "light": "#F4F1EA" }
  },
  "styling": { "eyebrows": "section" },
  "layout": {
    "tocPosition": "right",
    "breadcrumbs": true,
    "tocDepth": 3
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "search": { "prompt": "Search Nika docs…" },
  "metadata": {
    "og:image": "https://docs.nika.sh/images/og-default.png",
    "og:type": "website",
    "twitter:card": "summary_large_image"
  },
  "banner": {
    "content": "🦋 Nika v0.80 · Diamond rewrite in progress. Forever-v0.x. See [live state →](/reference/status)",
    "dismissible": true
  },
  "navbar": {
    "links": [
      { "label": "Live state", "href": "/reference/status" },
      { "label": "GitHub", "href": "https://github.com/supernovae-st/nika" }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "/getting-started/installation"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/supernovae-st/nika",
      "x": "https://x.com/ThibautMelen"
    },
    "links": [
      {
        "header": "Nika",
        "items": [
          { "label": "Site", "href": "https://nika.sh" },
          { "label": "Live state", "href": "/reference/status" },
          { "label": "Constellation", "href": "/reference/constellation" }
        ]
      },
      {
        "header": "Build",
        "items": [
          { "label": "Source (AGPL)", "href": "https://github.com/supernovae-st/nika" },
          { "label": "TypeScript SDK", "href": "https://github.com/supernovae-st/nika-client" },
          { "label": "Design skill", "href": "https://github.com/supernovae-st/nika-design-skill" },
          { "label": "Homebrew tap", "href": "https://github.com/supernovae-st/homebrew-tap" }
        ]
      },
      {
        "header": "Studio",
        "items": [
          { "label": "SuperNovae", "href": "https://supernovae.studio" }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Overview",
            "pages": ["introduction"]
          },
          {
            "group": "Getting started",
            "pages": [
              "getting-started/installation",
              "getting-started/first-workflow",
              "getting-started/editors"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/architecture",
              "concepts/workflows",
              "concepts/verbs",
              "concepts/bindings",
              "concepts/events",
              "concepts/providers"
            ]
          }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          {
            "group": "Foundations",
            "pages": [
              "architecture/layers",
              "architecture/forward-compat-invariants",
              "architecture/l0-decisions",
              "architecture/admission"
            ]
          },
          {
            "group": "Decisions",
            "pages": [
              "architecture/adrs"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "YAML",
            "pages": [
              "reference/yaml-syntax",
              "reference/schema"
            ]
          },
          {
            "group": "CLI & errors",
            "pages": [
              "reference/cli",
              "reference/error-codes"
            ]
          },
          {
            "group": "Data catalogs",
            "pages": [
              "reference/providers-catalog",
              "reference/capabilities"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "reference/status",
              "reference/constellation"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Cadence",
            "pages": [
              "changelog/releases",
              "changelog/roadmap"
            ]
          }
        ]
      }
    ]
  }
}
