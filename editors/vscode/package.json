{
  "name": "nika-lang",
  "displayName": "Nika Workflow Language",
  "description": "Language support for Nika (.nika.yaml) workflow files - syntax highlighting, completions, hover docs, go-to-definition, and diagnostics.",
  "version": "0.75.0",
  "publisher": "supernovae",
  "license": "AGPL-3.0-or-later",
  "icon": "icons/nika-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/supernovae-st/nika"
  },
  "homepage": "https://github.com/supernovae-st/nika",
  "bugs": {
    "url": "https://github.com/supernovae-st/nika/issues"
  },
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "nika",
    "yaml",
    "workflow",
    "ai",
    "llm",
    "mcp"
  ],
  "activationEvents": [
    "workspaceContains:**/*.nika.yaml",
    "onLanguage:nika"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nika",
          "title": "Nika",
          "icon": "./icons/nika-dark.svg"
        }
      ]
    },
    "views": {
      "nika": [
        {
          "id": "nikaWorkflows",
          "name": "Workflows"
        }
      ]
    },
    "languages": [
      {
        "id": "nika",
        "aliases": [
          "Nika Workflow",
          "nika"
        ],
        "extensions": [
          ".nika.yaml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/nika-light.svg",
          "dark": "./icons/nika-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nika",
        "scopeName": "source.nika",
        "path": "./syntaxes/nika.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nika",
        "path": "./snippets/nika.code-snippets"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "nika",
        "scopes": {
          "keyword": [
            "keyword.control.nika"
          ],
          "macro": [
            "entity.name.function.verb.nika"
          ],
          "property": [
            "variable.other.property.nika"
          ],
          "variable": [
            "variable.other.template.nika"
          ],
          "function": [
            "entity.name.function.nika"
          ],
          "type": [
            "entity.name.type.nika"
          ],
          "comment": [
            "comment.nika"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "nika.runWorkflow",
        "title": "Nika: Run Current Workflow",
        "icon": "$(play)"
      },
      {
        "command": "nika.checkWorkflow",
        "title": "Nika: Validate Current Workflow",
        "icon": "$(check)"
      },
      {
        "command": "nika.newWorkflow",
        "title": "Nika: New Workflow File",
        "icon": "$(new-file)"
      },
      {
        "command": "nika.restartServer",
        "title": "Nika: Restart Language Server",
        "icon": "$(refresh)"
      },
      {
        "command": "nika.showTasks",
        "title": "Nika: Show Tasks (Outline)",
        "icon": "$(list-tree)"
      },
      {
        "command": "nika.showOutput",
        "title": "Nika: Show Output",
        "icon": "$(output)"
      },
      {
        "command": "nika.showDag",
        "title": "Nika: Show Workflow DAG",
        "icon": "$(type-hierarchy)"
      }
    ],
    "configuration": {
      "title": "Nika",
      "properties": {
        "nika.server.path": {
          "type": "string",
          "default": "nika",
          "description": "Path to the nika binary. Uses PATH by default."
        },
        "nika.server.autoDownload": {
          "type": "boolean",
          "default": true,
          "description": "Automatically download the nika binary from GitHub releases if not found in PATH."
        },
        "nika.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to the nika lsp command."
        },
        "nika.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inlay hints (timeout annotations, model costs, binding labels)."
        },
        "nika.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show code lens actions (Run, Validate, task count, last run status)."
        },
        "nika.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Nika language server."
        }
      }
    },
    "configurationDefaults": {
      "[nika]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced"
      },
      "files.associations": {
        "*.nika.yaml": "nika",
        "*.nika.yml": "nika"
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "nika.runWorkflow",
          "when": "resourceLangId == 'nika'",
          "group": "navigation"
        },
        {
          "command": "nika.checkWorkflow",
          "when": "resourceLangId == 'nika'",
          "group": "navigation"
        },
        {
          "command": "nika.showDag",
          "when": "resourceLangId == 'nika'",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "nika.runWorkflow",
          "when": "resourceLangId == 'nika'",
          "group": "nika@1"
        },
        {
          "command": "nika.checkWorkflow",
          "when": "resourceLangId == 'nika'",
          "group": "nika@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nika.runWorkflow",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "resourceLangId == 'nika'"
      },
      {
        "command": "nika.checkWorkflow",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "resourceLangId == 'nika'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.mjs",
    "compile:ts": "tsc -p ./",
    "compile:webview": "node esbuild.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "dependencies": {
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "elkjs": "^0.9.3",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  }
}
