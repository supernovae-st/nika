{
  "New Workflow": {
    "prefix": ["workflow", "nika"],
    "description": "Complete Nika workflow file",
    "body": [
      "schema: \"nika/workflow@0.12\"",
      "workflow: ${1:my-workflow}",
      "description: \"${2:What this workflow does}\"",
      "provider: ${3|anthropic,openai,mistral,groq,deepseek,gemini,xai,native|}",
      "",
      "tasks:",
      "  - id: ${4:first-task}",
      "    infer: \"${5:Your prompt here}\"",
      "$0"
    ]
  },
  "Task": {
    "prefix": ["task", "newtask"],
    "description": "New task block",
    "body": [
      "  - id: ${1:task-id}",
      "    ${2|infer,exec,fetch,invoke,agent|}: ${3:\"$0\"}"
    ]
  },
  "Infer Task": {
    "prefix": ["infer", "llm", "prompt"],
    "description": "LLM inference task with prompt",
    "body": [
      "  - id: ${1:generate}",
      "    infer:",
      "      prompt: |",
      "        ${2:Your prompt here}",
      "      model: ${3|claude-sonnet-4-20250514,claude-opus-4-20250514,gpt-4o,gpt-4.1,mistral-large-latest,llama-4-maverick,gemini-2.5-pro,deepseek-chat|}",
      "      ${4:temperature: 0.7}",
      "$0"
    ]
  },
  "Infer with System": {
    "prefix": ["infersys", "system"],
    "description": "Infer task with system prompt",
    "body": [
      "  - id: ${1:generate}",
      "    infer:",
      "      system: \"${2:You are a helpful assistant.}\"",
      "      prompt: |",
      "        ${3:Your prompt here}",
      "      model: ${4|claude-sonnet-4-20250514,gpt-4o,mistral-large-latest|}",
      "$0"
    ]
  },
  "Exec Task": {
    "prefix": ["exec", "shell", "cmd"],
    "description": "Shell command task",
    "body": [
      "  - id: ${1:run}",
      "    exec: \"${2:echo hello}\"",
      "$0"
    ]
  },
  "Exec Multi-line": {
    "prefix": ["execblock", "shellblock"],
    "description": "Multi-line shell command",
    "body": [
      "  - id: ${1:run}",
      "    exec:",
      "      command: |",
      "        ${2:echo hello}",
      "      shell: ${3|true,false|}",
      "      ${4:timeout: 30}",
      "$0"
    ]
  },
  "Fetch Task": {
    "prefix": ["fetch", "http", "api"],
    "description": "HTTP request task",
    "body": [
      "  - id: ${1:request}",
      "    fetch:",
      "      url: \"${2:https://api.example.com}\"",
      "      method: ${3|GET,POST,PUT,DELETE,PATCH|}",
      "      ${4:headers:}",
      "        ${5:Content-Type: application/json}",
      "$0"
    ]
  },
  "Fetch with Extract": {
    "prefix": ["fetchextract", "scrape"],
    "description": "HTTP request with extraction",
    "body": [
      "  - id: ${1:scrape}",
      "    fetch:",
      "      url: \"${2:https://example.com}\"",
      "      extract: ${3|markdown,article,text,selector,metadata,links,jsonpath,feed,llm_txt|}",
      "      ${4:selector: \"${5:main}\"}",
      "$0"
    ]
  },
  "Invoke Task": {
    "prefix": ["invoke", "mcp", "tool"],
    "description": "MCP tool invocation",
    "body": [
      "  - id: ${1:call}",
      "    invoke:",
      "      tool: \"${2:server::tool_name}\"",
      "      params:",
      "        ${3:key}: ${4:value}",
      "$0"
    ]
  },
  "Invoke Nika Tool": {
    "prefix": ["niktool", "builtin"],
    "description": "Invoke a built-in nika: tool",
    "body": [
      "  - id: ${1:media}",
      "    invoke:",
      "      tool: \"nika:${2|import,thumbnail,dimensions,thumbhash,dominant_color,pipeline,convert,strip,metadata,optimize,svg_render,phash,compare,chart,provenance,verify,qr_validate,quality|}\"",
      "      params:",
      "        ${3:input}: \"${4:\\{\\{with.$5\\}\\}}\"",
      "$0"
    ]
  },
  "Agent Task": {
    "prefix": ["agent", "loop", "agentic"],
    "description": "Multi-turn agent loop",
    "body": [
      "  - id: ${1:assistant}",
      "    agent:",
      "      system: \"${2:You are a helpful assistant.}\"",
      "      prompt: \"${3:Complete the user's request}\"",
      "      tools:",
      "        - ${4:server::tool_name}",
      "      max_turns: ${5:10}",
      "$0"
    ]
  },
  "With Bindings": {
    "prefix": ["with", "bind"],
    "description": "Data binding block",
    "body": [
      "    with:",
      "      ${1:alias}: \\$${2:source_task}",
      "$0"
    ]
  },
  "Depends On": {
    "prefix": ["depends", "dep", "after"],
    "description": "Task dependency",
    "body": [
      "    depends_on: [${1:task_id}]"
    ]
  },
  "For Each Loop": {
    "prefix": ["foreach", "loop", "iterate"],
    "description": "Parallel iteration over items",
    "body": [
      "  - id: ${1:process}",
      "    for_each: \"\\$${2:list_task}\"",
      "    as: ${3:item}",
      "    concurrency: ${4:3}",
      "    ${5|infer,exec,fetch,invoke|}: \"${6:Process \\{\\{with.item\\}\\}}\"",
      "$0"
    ]
  },
  "MCP Server Config": {
    "prefix": ["mcpserver", "mcpconfig"],
    "description": "MCP server configuration block",
    "body": [
      "mcp:",
      "  ${1:server-name}:",
      "    command: ${2|npx,uvx,node,python|}",
      "    args:",
      "      - ${3:package-name}",
      "$0"
    ]
  },
  "Guard Block": {
    "prefix": ["guard", "guardrail"],
    "description": "Guardrail validation on task output",
    "body": [
      "    guardrails:",
      "      - type: ${1|length,schema,regex,llm|}",
      "        on_failure: ${2|retry,escalate,fail|}",
      "$0"
    ]
  },
  "Retry Block": {
    "prefix": ["retry", "resilience"],
    "description": "Retry configuration",
    "body": [
      "    retry:",
      "      max_attempts: ${1:3}",
      "      delay_ms: ${2:2000}",
      "      backoff: ${3:2.0}",
      "$0"
    ]
  },
  "Structured Output": {
    "prefix": ["structured", "json", "schema"],
    "description": "Structured JSON output with schema",
    "body": [
      "    output:",
      "      format: json",
      "    structured:",
      "      schema:",
      "        type: object",
      "        properties:",
      "          ${1:name}:",
      "            type: ${2|string,number,boolean,array,object|}",
      "            description: \"${3:Description}\"",
      "        required: [${4:\"$1\"}]",
      "$0"
    ]
  },
  "Vision Content": {
    "prefix": ["vision", "image", "content"],
    "description": "Multimodal vision content block",
    "body": [
      "  - id: ${1:analyze}",
      "    infer:",
      "      content:",
      "        - type: image",
      "          source: \"${2:\\{\\{with.photo.media[0].hash\\}\\}}\"",
      "          detail: ${3|high,low,auto|}",
      "        - type: text",
      "          text: \"${4:Describe this image}\"",
      "$0"
    ]
  },
  "Pipeline (2 tasks)": {
    "prefix": ["pipe2", "chain2"],
    "description": "Two-task pipeline with dependency",
    "body": [
      "  - id: ${1:step1}",
      "    ${2|infer,exec,fetch,invoke|}: \"${3:First step}\"",
      "",
      "  - id: ${4:step2}",
      "    with:",
      "      prev: \\$$1",
      "    ${5|infer,exec,fetch,invoke|}: \"${6:Process \\{\\{with.prev\\}\\}}\"",
      "    depends_on: [$1]",
      "$0"
    ]
  },
  "Pipeline (3 tasks)": {
    "prefix": ["pipe3", "chain3"],
    "description": "Three-task pipeline with chained dependencies",
    "body": [
      "  - id: ${1:research}",
      "    infer: \"${2:Research the topic}\"",
      "",
      "  - id: ${3:draft}",
      "    with:",
      "      data: \\$$1",
      "    infer: \"${4:Draft based on \\{\\{with.data\\}\\}}\"",
      "    depends_on: [$1]",
      "",
      "  - id: ${5:refine}",
      "    with:",
      "      draft: \\$$3",
      "    infer: \"${6:Refine and polish \\{\\{with.draft\\}\\}}\"",
      "    depends_on: [$3]",
      "$0"
    ]
  },
  "Artifact Output": {
    "prefix": ["artifact", "output"],
    "description": "Artifact block to persist task output to file",
    "body": [
      "artifact:",
      "  path: ${1:output.md}",
      "  format: ${2|markdown,json,yaml,text,binary|}",
      "  mode: ${3|overwrite,append,unique,fail|}",
      "$0"
    ]
  },
  "Resource Limits": {
    "prefix": ["limits", "budget"],
    "description": "Resource limits for agent tasks",
    "body": [
      "limits:",
      "  max_cost_usd: ${1:2.0}",
      "  max_duration_secs: ${2:120}",
      "$0"
    ]
  },
  "Context Files": {
    "prefix": ["context", "files"],
    "description": "Context block to load files into workflow",
    "body": [
      "context:",
      "  files:",
      "    ${1:readme}: ${2:./README.md}",
      "$0"
    ]
  },
  "Include Partial": {
    "prefix": ["include", "partial", "imports"],
    "description": "Include partial workflows",
    "body": [
      "include:",
      "  - path: ${1:./partials/setup.nika.yaml}",
      "    prefix: ${2:setup_}",
      "$0"
    ]
  },
  "Vision Content": {
    "prefix": ["contentvision", "multimodal", "imagecontent"],
    "description": "Multimodal content with image and text",
    "body": [
      "infer:",
      "  content:",
      "    - type: image",
      "      source: \"${1:\\{\\{with.photo_hash\\}\\}}\"",
      "      detail: ${2|high,low,auto|}",
      "    - type: text",
      "      text: \"${3:Describe this image in detail}\"",
      "$0"
    ]
  },
  "For-Each Fetch": {
    "prefix": ["foreachfetch", "scrapeall", "fetchloop"],
    "description": "Fan-out: fetch multiple URLs in parallel",
    "body": [
      "- id: ${1:scrape_all}",
      "  with:",
      "    urls: \\$${2:get_urls}",
      "  for_each: \"\\{\\{with.urls\\}\\}\"",
      "  as: url",
      "  concurrency: ${3:5}",
      "  fetch:",
      "    url: \"\\{\\{with.url\\}\\}\"",
      "    extract: ${4|article,markdown,text,metadata,links|}",
      "$0"
    ]
  },
  "Fan-Out Fan-In": {
    "prefix": ["fanout", "parallel", "mapreduce"],
    "description": "Full fan-out/fan-in pipeline: generate → process → synthesize",
    "body": [
      "- id: ${1:generate}",
      "  infer: \"${2:List 5 items about \\{\\{inputs.topic\\}\\}}\"",
      "  structured:",
      "    schema:",
      "      type: object",
      "      properties:",
      "        items: { type: array, items: { type: string } }",
      "",
      "- id: ${3:process}",
      "  with:",
      "    data: \\$$1",
      "  for_each: \"\\{\\{with.data.items\\}\\}\"",
      "  as: item",
      "  concurrency: ${4:3}",
      "  infer: \"${5:Process: \\{\\{with.item\\}\\}}\"",
      "",
      "- id: ${6:synthesize}",
      "  depends_on: [$3]",
      "  with:",
      "    results: \\$$3",
      "  infer: \"${7:Synthesize: \\{\\{with.results | join('\\\\n')\\}\\}}\"",
      "$0"
    ]
  }
}
