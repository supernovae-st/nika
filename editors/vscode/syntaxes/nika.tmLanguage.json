{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nika Workflow",
  "scopeName": "source.nika",
  "fileTypes": ["nika.yaml"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#schema-line" },
    { "include": "#workflow-line" },
    { "include": "#provider-line" },
    { "include": "#top-level-keys" },
    { "include": "#task-id" },
    { "include": "#verbs" },
    { "include": "#task-fields" },
    { "include": "#verb-sub-fields" },
    { "include": "#template-expression" },
    { "include": "#dollar-reference" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#null" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.nika"
    },
    "schema-line": {
      "match": "^(schema)(:)\\s*(nika/workflow@[\\d.]+)",
      "captures": {
        "1": { "name": "keyword.control.schema.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" },
        "3": { "name": "string.unquoted.schema-version.nika" }
      }
    },
    "workflow-line": {
      "match": "^(workflow)(:)\\s*(\\S+)",
      "captures": {
        "1": { "name": "keyword.control.workflow.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" },
        "3": { "name": "entity.name.function.workflow-name.nika" }
      }
    },
    "provider-line": {
      "match": "^(provider)(:)\\s*(\\S+)",
      "captures": {
        "1": { "name": "keyword.control.provider.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" },
        "3": { "name": "support.constant.provider-name.nika" }
      }
    },
    "top-level-keys": {
      "match": "^(tasks|mcp|context|include|inputs)(:)",
      "captures": {
        "1": { "name": "keyword.control.top-level.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" }
      }
    },
    "task-id": {
      "match": "^\\s*-?\\s*(id)(:)\\s*([\"']?)([\\w-]+)\\3",
      "captures": {
        "1": { "name": "keyword.other.id.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" },
        "3": { "name": "punctuation.definition.string.nika" },
        "4": { "name": "entity.name.function.task-id.nika" }
      }
    },
    "verbs": {
      "match": "^\\s+(infer|exec|fetch|invoke|agent)(:)",
      "captures": {
        "1": { "name": "keyword.control.verb.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" }
      }
    },
    "task-fields": {
      "match": "^\\s+(with|depends_on|for_each|as|concurrency|fail_fast|output|guard|on_error|retry|timeout|structured)(:)",
      "captures": {
        "1": { "name": "support.type.field.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" }
      }
    },
    "verb-sub-fields": {
      "match": "^\\s+(prompt|model|temperature|system|max_tokens|extended_thinking|thinking_budget|command|shell|cwd|url|method|headers|body|mcp|tool|params|max_turns|depth_limit|tools)(:)",
      "captures": {
        "1": { "name": "variable.other.property.nika" },
        "2": { "name": "punctuation.separator.key-value.nika" }
      }
    },
    "template-expression": {
      "match": "(\\{\\{)([^}]+)(\\}\\})",
      "captures": {
        "1": { "name": "punctuation.definition.template.begin.nika" },
        "2": { "name": "variable.other.template.nika" },
        "3": { "name": "punctuation.definition.template.end.nika" }
      }
    },
    "dollar-reference": {
      "match": "\\$(\\w[\\w-]*)",
      "captures": {
        "0": { "name": "variable.other.reference.nika" }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nika",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#template-expression" },
            {
              "name": "constant.character.escape.nika",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nika",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#template-expression" }
          ]
        }
      ]
    },
    "numbers": {
      "match": "(?<=:\\s)\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.nika"
    },
    "booleans": {
      "match": "(?<=:\\s)(true|false)\\b",
      "name": "constant.language.boolean.nika"
    },
    "null": {
      "match": "(?<=:\\s)(null|~)\\b",
      "name": "constant.language.null.nika"
    }
  }
}
