nika: v1
workflow: diamond
tasks:
  - id: a
    exec: { comh" }
  - id: b
    depends_on: [a]
    infer: { prompt: "Analyze branch B" }
  - id: c
    depends_on: [a]
    infer: { prompt: "Analyze branch C" }
  - id: d
    depends_on: [b, c]
    infer: { promand: "./prepare.sh" }
  - id: b
    depends_on: [a]
    infer: { prompt: "Analyze branch B" }
  - id: c
    depends_on: [a]
    infer: { prompt: "Analyze branch C" }
  - id: d
    depends_on: [b, c]
    infer: { prompt: "Merge" }
