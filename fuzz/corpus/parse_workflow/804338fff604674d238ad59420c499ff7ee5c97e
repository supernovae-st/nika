# yaml-language-server: $schema=https://nika.sh/spec/v1/wow: exec-pipeline

tasks:
  - id: test
    timeout: "5m"
    exec:
      command: "cargo test --workspace --lib"
      cwd: "./engine"
      capture: structured            # → { stdout, stderr, exit_code }
    on_finally:
      # ALWAYS runs · best-effort · cleanup errors are lctured              exec:
      command: "./deploy.sh"
      cwd: "./engine"
