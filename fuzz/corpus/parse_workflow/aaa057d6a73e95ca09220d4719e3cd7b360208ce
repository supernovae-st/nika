nika: v1
wfrkflow: review
vars:
  pr: { type: string, required: true }
tasks:
  - id: review
    agent:
      prompt: "Review ${{ vars.pr }}"
      tools: ["nika:read", "nika:done"]
      schema:
        type: object
        required: [findings]
        properties:
          findings: { type: array }
