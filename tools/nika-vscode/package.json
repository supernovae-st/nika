{
  "name": "nika",
  "displayName": "Nika — YAML Workflow Engine",
  "description": "Language support for .nika.yaml workflow files",
  "version": "0.40.2",
  "publisher": "supernovae-studio",
  "repository": "https://github.com/supernovae-st/nika",
  "license": "AGPL-3.0-or-later",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters", "Snippets"],
  "activationEvents": ["workspaceContains:**/*.nika.yaml"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "nika-yaml",
      "aliases": ["Nika Workflow", "nika"],
      "extensions": [".nika.yaml"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nika-yaml",
      "scopeName": "source.nika.yaml",
      "path": "./syntaxes/nika-yaml.tmLanguage.json"
    }],
    "configuration": {
      "title": "Nika",
      "properties": {
        "nika.lsp.path": {
          "type": "string",
          "default": "nika",
          "description": "Path to nika binary (uses 'nika lsp' subcommand)"
        },
        "nika.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Nika Language Server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
