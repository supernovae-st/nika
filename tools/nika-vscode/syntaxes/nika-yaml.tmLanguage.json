{
  "name": "Nika Workflow",
  "scopeName": "source.nika.yaml",
  "fileTypes": ["nika.yaml"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#template-expressions" },
    { "include": "#task-references" },
    { "include": "#nika-verbs" },
    { "include": "#nika-keywords" },
    { "include": "#nika-builtins" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#yaml-keys" },
    { "include": "#yaml-tags" },
    { "include": "#yaml-anchors" }
  ],
  "repository": {
    "comments": {
      "match": "(?:^|\\s+)(#.*)$",
      "captures": {
        "1": { "name": "comment.line.number-sign.nika-yaml" }
      }
    },
    "template-expressions": {
      "match": "\\{\\{(.+?)\\}\\}",
      "name": "meta.template.nika-yaml",
      "captures": {
        "0": { "name": "string.interpolated.nika-yaml" },
        "1": { "name": "variable.other.template.nika-yaml" }
      }
    },
    "task-references": {
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.task-ref.nika-yaml"
    },
    "nika-verbs": {
      "match": "^(\\s*)(infer|exec|fetch|invoke|agent)(:)",
      "captures": {
        "2": { "name": "keyword.control.verb.nika-yaml" },
        "3": { "name": "punctuation.separator.key-value.nika-yaml" }
      }
    },
    "nika-keywords": {
      "match": "^(\\s*)(schema|name|tasks|depends_on|with|prompt|model|provider|content|timeout|retry|extract|selector|response|output|tools|system|temperature|max_tokens|format|on_error|parallel|condition|loop)(:)",
      "captures": {
        "2": { "name": "support.type.property-name.nika-yaml" },
        "3": { "name": "punctuation.separator.key-value.nika-yaml" }
      }
    },
    "nika-builtins": {
      "match": "\\bnika:[a-z_]+\\b",
      "name": "entity.name.function.builtin.nika-yaml"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nika-yaml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#template-expressions" },
            { "include": "#task-references" },
            {
              "name": "constant.character.escape.nika-yaml",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nika-yaml",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nika-yaml",
              "match": "''"
            }
          ]
        }
      ]
    },
    "numbers": {
      "match": "(?<=:\\s)[-+]?[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?\\s*$",
      "name": "constant.numeric.nika-yaml"
    },
    "booleans": {
      "match": "(?<=:\\s)(true|false|yes|no|on|off)\\s*$",
      "name": "constant.language.boolean.nika-yaml"
    },
    "yaml-keys": {
      "match": "^(\\s*)([a-zA-Z_][a-zA-Z0-9_-]*)(:)",
      "captures": {
        "2": { "name": "entity.name.tag.yaml.nika-yaml" },
        "3": { "name": "punctuation.separator.key-value.nika-yaml" }
      }
    },
    "yaml-tags": {
      "match": "!\\S+",
      "name": "storage.type.tag.nika-yaml"
    },
    "yaml-anchors": {
      "patterns": [
        {
          "match": "&\\S+",
          "name": "keyword.control.anchor.nika-yaml"
        },
        {
          "match": "\\*\\S+",
          "name": "variable.other.alias.nika-yaml"
        }
      ]
    }
  }
}
