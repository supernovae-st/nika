{
  "mcpServers": {
    "dataforseo": {
      "args": [
        "-y",
        "dataforseo-mcp-server"
      ],
      "command": "npx",
      "env": {
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}",
        "DATAFORSEO_USERNAME": "${DATAFORSEO_USERNAME}",
        "ENABLED_MODULES": "KEYWORDS_DATA,SERP,DATAFORSEO_LABS"
      }
    },
    "firecrawl": {
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "command": "npx",
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "neo4j": {
      "args": [
        "mcp-neo4j-cypher"
      ],
      "command": "uvx",
      "env": {
        "NEO4J_PASSWORD": "novanetpassword",
        "NEO4J_URI": "neo4j://localhost:7687",
        "NEO4J_USERNAME": "neo4j"
      }
    },
    "novanet": {
      "args": [
        "run",
        "--manifest-path",
        "/Users/thibaut/dev/supernovae/novanet/tools/novanet-mcp/Cargo.toml",
        "--release"
      ],
      "command": "cargo",
      "env": {
        "NOVANET_MCP_NEO4J_PASSWORD": "novanetpassword",
        "NOVANET_MCP_NEO4J_URI": "bolt://localhost:7687",
        "NOVANET_MCP_NEO4J_USER": "neo4j"
      }
    },
    "perplexity": {
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "command": "npx",
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    },
    "supadata": {
      "args": [
        "-y",
        "@supadata/mcp"
      ],
      "command": "npx",
      "env": {
        "SUPADATA_API_KEY": "${SUPADATA_API_KEY}"
      }
    }
  }
}