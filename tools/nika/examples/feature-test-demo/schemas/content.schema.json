{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nika://feature-test-demo/content",
  "title": "ContentOutput",
  "description": "Complex schema for multi-format content generation",
  "type": "object",
  "required": ["format", "content", "metadata", "quality_metrics"],
  "properties": {
    "format": {
      "type": "string",
      "enum": ["md", "txt", "json", "html"]
    },
    "content": {
      "type": "object",
      "required": ["title", "body", "sections"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "subtitle": { "type": "string", "maxLength": 200 },
        "body": {
          "type": "string",
          "minLength": 200
        },
        "sections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["heading", "content", "order"],
            "properties": {
              "heading": { "type": "string" },
              "content": { "type": "string", "minLength": 50 },
              "order": { "type": "integer", "minimum": 1 },
              "subsections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["heading", "content"],
                  "properties": {
                    "heading": { "type": "string" },
                    "content": { "type": "string" },
                    "code_blocks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["language", "code"],
                        "properties": {
                          "language": { "type": "string" },
                          "code": { "type": "string" },
                          "caption": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "content"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["info", "warning", "tip", "note", "important"]
              },
              "content": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["word_count", "reading_time_minutes", "generated_at"],
      "properties": {
        "word_count": { "type": "integer", "minimum": 100 },
        "reading_time_minutes": { "type": "number", "minimum": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "source_task": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 15
        },
        "target_audience": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced", "expert"]
        },
        "content_type": {
          "type": "string",
          "enum": ["article", "tutorial", "reference", "guide", "overview"]
        }
      }
    },
    "quality_metrics": {
      "type": "object",
      "required": ["readability_score", "completeness"],
      "properties": {
        "readability_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Flesch-Kincaid readability score"
        },
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coherence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "factual_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "meta_description": {
          "type": "string",
          "minLength": 120,
          "maxLength": 160
        },
        "focus_keyword": { "type": "string" },
        "secondary_keywords": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 5
        },
        "internal_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["anchor", "url"],
            "properties": {
              "anchor": { "type": "string" },
              "url": { "type": "string", "format": "uri-reference" }
            }
          }
        }
      }
    }
  }
}
