{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nika://feature-test-demo/research",
  "title": "ResearchOutput",
  "description": "Complex nested schema for research output validation",
  "type": "object",
  "required": ["meta", "sources", "analysis", "key_findings"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["subject", "timestamp", "agent_id", "depth"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "agent_id": { "type": "string", "pattern": "^agent-[a-z0-9-]+$" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 3 },
        "tokens_used": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["url", "title", "relevance_score", "provider"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "provider": {
            "type": "string",
            "enum": ["perplexity", "firecrawl", "fetch"]
          },
          "extracted_at": { "type": "string", "format": "date-time" },
          "content_preview": { "type": "string", "maxLength": 500 },
          "metadata": {
            "type": "object",
            "properties": {
              "word_count": { "type": "integer", "minimum": 0 },
              "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
              "author": { "type": "string" },
              "published_date": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["summary", "themes", "sentiment"],
      "properties": {
        "summary": { "type": "string", "minLength": 100, "maxLength": 2000 },
        "themes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["name", "confidence", "mentions"],
            "properties": {
              "name": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "mentions": { "type": "integer", "minimum": 1 },
              "related_keywords": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "sentiment": {
          "type": "object",
          "required": ["overall", "score"],
          "properties": {
            "overall": {
              "type": "string",
              "enum": ["positive", "negative", "neutral", "mixed"]
            },
            "score": { "type": "number", "minimum": -1, "maximum": 1 },
            "breakdown": {
              "type": "object",
              "properties": {
                "positive": { "type": "number", "minimum": 0, "maximum": 1 },
                "negative": { "type": "number", "minimum": 0, "maximum": 1 },
                "neutral": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["person", "organization", "location", "product", "technology", "concept"]
              },
              "frequency": { "type": "integer", "minimum": 1 },
              "salience": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "key_findings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["finding", "confidence", "sources"],
        "properties": {
          "finding": { "type": "string", "minLength": 20, "maxLength": 500 },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "contradictions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
