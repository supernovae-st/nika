{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nika.dev/schemas/workflow.json",
  "title": "Nika Workflow",
  "description": "Schema for .nika.yaml workflow files - DAG workflow runner for AI tasks",
  "type": "object",
  "required": ["schema", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^nika/workflow@0\\.[1-9][0-9]?$",
      "description": "Workflow schema version (nika/workflow@0.1 through @0.99)",
      "examples": ["nika/workflow@0.9", "nika/workflow@0.10"]
    },
    "workflow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Workflow identifier (lowercase alphanumeric with hyphens)",
      "examples": ["generate-page", "seo-pipeline"]
    },
    "description": {
      "type": "string",
      "description": "Human-readable workflow description"
    },
    "provider": {
      "type": "string",
      "enum": ["claude", "openai", "mistral", "groq", "deepseek", "gemini", "ollama", "mock"],
      "default": "claude",
      "description": "Default LLM provider for infer and agent tasks"
    },
    "model": {
      "type": "string",
      "description": "Default model override (e.g., claude-sonnet-4-6, gpt-4o)",
      "examples": ["claude-sonnet-4-6", "gpt-4o-mini", "gemini-2.0-flash"]
    },
    "context": {
      "$ref": "#/$defs/ContextSpec",
      "description": "File loading at workflow start (v0.9+)"
    },
    "include": {
      "type": "array",
      "description": "External workflows to merge into DAG (v0.9+)",
      "items": {
        "$ref": "#/$defs/IncludeSpec"
      }
    },
    "skills": {
      "type": "object",
      "description": "Workflow-level skills for prompt augmentation (v0.6+). Map of alias → skill file path.",
      "additionalProperties": {
        "type": "string",
        "description": "Path to skill file (local or pkg: URI)",
        "examples": ["./skills/writing.skill.md", "pkg:@spn/core@1.0.0/skills/coding.md"]
      },
      "examples": [{"seo": "./skills/seo.skill.md", "brand": "./skills/brand.skill.md"}]
    },
    "mcp": {
      "type": "object",
      "description": "MCP server configurations (v0.2+)",
      "additionalProperties": {
        "$ref": "#/$defs/McpServerConfig"
      }
    },
    "tasks": {
      "type": "array",
      "description": "List of tasks to execute",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Task"
      }
    },
    "flows": {
      "type": "array",
      "description": "DAG edges defining task dependencies",
      "items": {
        "$ref": "#/$defs/Flow"
      }
    },
    "artifacts": {
      "$ref": "#/$defs/ArtifactsConfig",
      "description": "Workflow-level artifact defaults (v0.10+)"
    },
    "log": {
      "$ref": "#/$defs/LogConfig",
      "description": "Workflow-level logging configuration (v0.10+)"
    },
    "agents": {
      "type": "object",
      "description": "Reusable agent definitions (v0.6+)",
      "additionalProperties": {
        "$ref": "#/$defs/AgentDef"
      }
    },
    "inputs": {
      "type": "object",
      "description": "Workflow input parameters (v0.10+)",
      "additionalProperties": {}
    }
  },
  "$defs": {
    "ContextSpec": {
      "type": "object",
      "description": "Context file loading configuration (v0.9+)",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "description": "File mappings (alias → path)",
          "additionalProperties": {
            "type": "string"
          },
          "examples": [{"brand": "./context/brand.md", "config": "./settings.json"}]
        },
        "session": {
          "type": "string",
          "description": "Session file path for state restoration"
        }
      }
    },
    "IncludeSpec": {
      "type": "object",
      "description": "External workflow to merge (v0.9+ path, v0.17+ pkg)",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to external .nika.yaml file"
        },
        "pkg": {
          "type": "string",
          "pattern": "^[a-z@][a-z0-9@/_.-]*$",
          "description": "Package reference (v0.17+) e.g., pkg:@spn/workflows@1.0.0/seo.nika.yaml"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Prefix for included task IDs (namespace isolation)"
        }
      },
      "oneOf": [
        { "required": ["path"] },
        { "required": ["pkg"] }
      ]
    },
    "McpServerConfig": {
      "type": "object",
      "description": "Inline MCP server configuration",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "description": "Command to spawn the MCP server",
          "examples": ["cargo", "node", "python", "npx"]
        },
        "args": {
          "type": "array",
          "description": "Arguments to pass to the command",
          "items": { "type": "string" },
          "examples": [["run", "-p", "novanet-mcp"]]
        },
        "env": {
          "type": "object",
          "description": "Environment variables for the server process",
          "additionalProperties": { "type": "string" }
        },
        "cwd": {
          "type": "string",
          "description": "Working directory for the server process"
        }
      }
    },
    "Task": {
      "type": "object",
      "description": "A task in the workflow DAG",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique task identifier (lowercase alphanumeric with underscores/hyphens)"
        },
        "use": {
          "$ref": "#/$defs/WiringSpec",
          "description": "Data wiring from previous task outputs"
        },
        "output": {
          "$ref": "#/$defs/OutputPolicy",
          "description": "Output format and validation"
        },
        "for_each": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {}
            },
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-z0-9_.]*$",
              "description": "Binding reference to an array (e.g., $locales, $inputs.items) (v0.22+ supports $inputs.*)"
            },
            {
              "type": "string",
              "pattern": "^\\{\\{(use|inputs|context)\\.[a-z][a-z0-9_.]*\\}\\}$",
              "description": "Template binding to an array (e.g., {{use.items}}, {{inputs.locales}})"
            }
          ],
          "description": "Array to iterate over in parallel (v0.3+)"
        },
        "as": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "default": "item",
          "description": "Variable name for current iteration value"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1,
          "description": "Maximum parallel executions for for_each"
        },
        "fail_fast": {
          "type": "boolean",
          "default": true,
          "description": "Stop all iterations on first error"
        },
        "decompose": {
          "$ref": "#/$defs/DecomposeSpec",
          "description": "Runtime DAG expansion (v0.5+)"
        },
        "infer": {
          "$ref": "#/$defs/InferParams",
          "description": "LLM inference task"
        },
        "exec": {
          "$ref": "#/$defs/ExecParams",
          "description": "Shell command execution task"
        },
        "fetch": {
          "$ref": "#/$defs/FetchParams",
          "description": "HTTP request task"
        },
        "invoke": {
          "$ref": "#/$defs/InvokeParams",
          "description": "MCP tool call task (v0.2+)"
        },
        "agent": {
          "$ref": "#/$defs/AgentParams",
          "description": "Agentic execution task (v0.2+)"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactSpec",
          "description": "Task-level artifact output (v0.10+)"
        },
        "log": {
          "$ref": "#/$defs/LogConfig",
          "description": "Task-level logging override (v0.10+)"
        },
        "structured": {
          "$ref": "#/$defs/StructuredOutputSpec",
          "description": "Structured output validation with 4-layer defense (v0.21+)"
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": "Explicit dependencies (task IDs that must complete before this task)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable task description"
        }
      },
      "oneOf": [
        { "required": ["id", "infer"] },
        { "required": ["id", "exec"] },
        { "required": ["id", "fetch"] },
        { "required": ["id", "invoke"] },
        { "required": ["id", "agent"] }
      ]
    },
    "DecomposeSpec": {
      "type": "object",
      "description": "Runtime DAG expansion via MCP traversal (v0.5+)",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["semantic", "static", "nested"],
          "description": "Expansion strategy"
        },
        "traverse": {
          "type": "string",
          "description": "Arc type to follow (for semantic strategy)"
        },
        "source": {
          "type": "string",
          "description": "Starting node reference (e.g., $entity)"
        },
        "mcp_server": {
          "type": "string",
          "default": "novanet",
          "description": "MCP server to use for traversal (default: novanet)"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum items to expand"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum recursion depth for nested strategy (default: 3)"
        }
      }
    },
    "InferParams": {
      "oneOf": [
        {
          "type": "string",
          "description": "Simple prompt string (shorthand)"
        },
        {
          "type": "object",
          "required": ["prompt"],
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "description": "LLM prompt (supports {{use.alias}} templates)"
            },
            "provider": {
              "type": "string",
              "enum": ["claude", "openai", "mistral", "groq", "deepseek", "gemini", "ollama", "mock"],
              "description": "Provider override for this task"
            },
            "model": {
              "type": "string",
              "description": "Model override for this task"
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "LLM temperature (0.0-2.0, higher = more creative)"
            },
            "system": {
              "type": "string",
              "description": "System prompt (persona/behavior)"
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "description": "Maximum output tokens"
            },
            "response_format": {
              "type": "string",
              "enum": ["json", "text", "markdown"],
              "description": "Expected response format (v0.10+)"
            },
            "extended_thinking": {
              "type": "boolean",
              "default": false,
              "description": "Enable extended thinking (Claude only, v0.4+)"
            },
            "thinking_budget": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65536,
              "default": 4096,
              "description": "Token budget for thinking (requires extended_thinking: true)"
            }
          }
        }
      ]
    },
    "ExecParams": {
      "oneOf": [
        {
          "type": "string",
          "description": "Simple command string (shorthand)"
        },
        {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "description": "Shell command to execute (supports {{use.alias}} templates)"
            },
            "shell": {
              "type": "boolean",
              "default": false,
              "description": "Execute via shell (default: false for security, set true for pipes/redirects)"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "description": "Timeout in seconds"
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for command"
            },
            "env": {
              "type": "object",
              "description": "Environment variables to set for the command (v0.22+)",
              "additionalProperties": { "type": "string" },
              "examples": [{"NODE_ENV": "production", "DEBUG": "true"}]
            }
          }
        }
      ]
    },
    "FetchParams": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to fetch"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
          "default": "GET",
          "description": "HTTP method"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "HTTP headers"
        },
        "body": {
          "type": "string",
          "description": "Request body (for POST/PUT/PATCH)"
        },
        "json": {
          "type": "object",
          "description": "JSON body (auto-serialized, sets Content-Type: application/json) (v0.22+)",
          "additionalProperties": true
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Request timeout in seconds"
        },
        "retry": {
          "$ref": "#/$defs/RetryConfig",
          "description": "Retry configuration for failed requests (v0.19+)"
        }
      }
    },
    "RetryConfig": {
      "type": "object",
      "description": "Retry configuration with exponential backoff (v0.19+)",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum retry attempts (default: 3)"
        },
        "backoff_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000,
          "default": 1000,
          "description": "Initial backoff in milliseconds (default: 1000)"
        },
        "multiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "default": 2,
          "description": "Backoff multiplier for exponential backoff (default: 2.0)"
        }
      }
    },
    "InvokeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "string",
          "description": "MCP server name (must match a key in workflow's mcp config)"
        },
        "server": {
          "type": "string",
          "description": "MCP server name (legacy alias for 'mcp', deprecated)"
        },
        "tool": {
          "type": "string",
          "description": "Tool name to call (mutually exclusive with resource)"
        },
        "params": {
          "type": "object",
          "description": "Parameters to pass to the tool"
        },
        "resource": {
          "type": "string",
          "description": "Resource URI to read (mutually exclusive with tool)"
        }
      },
      "oneOf": [
        { "required": ["mcp", "tool"] },
        { "required": ["mcp", "resource"] },
        { "required": ["server", "tool"] },
        { "required": ["server", "resource"] },
        {
          "required": ["tool"],
          "properties": {
            "tool": {
              "pattern": "^nika:"
            }
          },
          "not": {
            "anyOf": [
              { "required": ["mcp"] },
              { "required": ["server"] },
              { "required": ["resource"] }
            ]
          }
        }
      ]
    },
    "AgentParams": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "description": "User prompt for the agent"
        },
        "system": {
          "type": "string",
          "description": "System prompt (agent persona/behavior)"
        },
        "provider": {
          "type": "string",
          "enum": ["claude", "openai", "mistral", "groq", "deepseek", "gemini", "ollama", "mock"],
          "description": "Provider override"
        },
        "model": {
          "type": "string",
          "description": "Model override"
        },
        "mcp": {
          "type": "array",
          "items": { "type": "string" },
          "description": "MCP servers the agent can access"
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Builtin tools the agent can use (nika:read, nika:write, etc.)"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Maximum agentic turns"
        },
        "depth_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum nested agent depth (spawn_agent protection)"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "LLM temperature"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "Maximum output tokens per turn (v0.18+)"
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1,
          "description": "Total token budget for agent execution (v0.5+)"
        },
        "extended_thinking": {
          "type": "boolean",
          "default": false,
          "description": "Enable extended thinking (Claude only, v0.4+)"
        },
        "thinking_budget": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536,
          "default": 4096,
          "description": "Token budget for thinking (requires extended_thinking: true)"
        },
        "tool_choice": {
          "type": "string",
          "enum": ["auto", "required", "none"],
          "default": "auto",
          "description": "Tool selection behavior (v0.8+)"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skills to inject into agent context (v0.15.4+)"
        },
        "stop_sequences": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sequences that stop generation"
        },
        "scope": {
          "type": "string",
          "enum": ["full", "minimal", "debug"],
          "description": "Scope preset for agent capabilities (v0.10+)"
        },
        "stop_conditions": {
          "type": "array",
          "description": "Structured stop conditions (v0.10+)",
          "items": {
            "oneOf": [
              { "type": "string", "description": "Simple string pattern" },
              {
                "type": "object",
                "required": ["pattern"],
                "properties": {
                  "pattern": { "type": "string", "description": "Pattern to match" },
                  "action": { "type": "string", "enum": ["complete", "fail", "continue"], "description": "Action on match" }
                }
              }
            ]
          }
        }
      }
    },
    "WiringSpec": {
      "type": "object",
      "description": "Data wiring from previous task outputs",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/WiringValue" }
        ]
      }
    },
    "WiringValue": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Source task.field reference (v0.5+ lazy bindings)"
        },
        "from": {
          "type": "string",
          "description": "Source task.field reference (legacy)"
        },
        "lazy": {
          "type": "boolean",
          "default": false,
          "description": "Defer resolution until first access (v0.5+)"
        },
        "default": {
          "description": "Default value if source is null"
        },
        "transform": {
          "type": "string",
          "enum": ["json", "yaml", "string", "trim"],
          "description": "Transform to apply"
        }
      }
    },
    "OutputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "yaml", "text", "markdown"],
          "default": "text",
          "description": "Expected output format"
        },
        "schema": {
          "oneOf": [
            { "type": "object", "description": "Inline JSON Schema object" },
            { "type": "string", "description": "Path to JSON Schema file" }
          ],
          "description": "JSON Schema for output validation (inline object or file path)"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2,
          "description": "Maximum retry attempts on validation failure (v0.10)"
        },
        "fallback_value": {
          "description": "Default value to use if validation fails after all retries (v0.22)"
        }
      }
    },
    "StructuredOutputSpec": {
      "description": "Structured output validation with 4-layer defense (v0.21+)",
      "oneOf": [
        {
          "type": "string",
          "description": "Shorthand: path to JSON Schema file"
        },
        {
          "type": "object",
          "required": ["schema"],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "oneOf": [
                { "type": "object", "description": "Inline JSON Schema object" },
                { "type": "string", "description": "Path to JSON Schema file" }
              ],
              "description": "JSON Schema for output validation (inline object or file path)"
            },
            "enable_extractor": {
              "type": "boolean",
              "default": true,
              "description": "Enable Layer 1: rig Extractor (Rust type extraction)"
            },
            "enable_tool_use": {
              "type": "boolean",
              "default": true,
              "description": "Enable Layer 2: Provider-native (tool_use / response_format)"
            },
            "enable_retry": {
              "type": "boolean",
              "default": true,
              "description": "Enable Layer 3: Retry with feedback"
            },
            "enable_repair": {
              "type": "boolean",
              "default": true,
              "description": "Enable Layer 4: LLM repair"
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 2,
              "description": "Maximum retry attempts for Layer 3"
            },
            "repair_model": {
              "type": "string",
              "description": "Model to use for Layer 4 repair (defaults to task model)"
            }
          }
        }
      ],
      "examples": [
        "./schemas/user.json",
        {
          "schema": "./schemas/product.json",
          "max_retries": 3,
          "enable_repair": true
        },
        {
          "schema": {
            "type": "object",
            "properties": { "name": { "type": "string" } },
            "required": ["name"]
          }
        }
      ]
    },
    "Flow": {
      "type": "object",
      "required": ["source", "target"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/FlowEndpoint",
          "description": "Source task(s)"
        },
        "target": {
          "$ref": "#/$defs/FlowEndpoint",
          "description": "Target task(s)"
        }
      }
    },
    "FlowEndpoint": {
      "oneOf": [
        {
          "type": "string",
          "description": "Single task ID"
        },
        {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Multiple task IDs"
        }
      ]
    },
    "ArtifactsConfig": {
      "type": "object",
      "description": "Workflow-level artifact defaults (v0.10+)",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "description": "Base directory for artifacts (supports templates)"
        },
        "format": {
          "type": "string",
          "enum": ["text", "json", "yaml"],
          "default": "text",
          "description": "Default output format"
        },
        "mode": {
          "type": "string",
          "enum": ["overwrite", "append", "unique", "fail"],
          "default": "overwrite",
          "description": "Default write mode"
        },
        "manifest": {
          "type": "boolean",
          "default": false,
          "description": "Generate artifacts.json manifest at workflow end"
        },
        "max_size": {
          "type": "integer",
          "minimum": 1,
          "default": 104857600,
          "description": "Maximum artifact size in bytes (default: 100MB)"
        }
      }
    },
    "ArtifactSpec": {
      "oneOf": [
        {
          "type": "boolean",
          "description": "Enable/disable artifact using workflow defaults"
        },
        {
          "type": "object",
          "description": "Single artifact with options",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "description": "Output path (supports templates)"
            },
            "source": {
              "type": "string",
              "description": "Which binding to save (default: task result)"
            },
            "template": {
              "type": "string",
              "description": "Template string to render with {{use.*}} bindings (v0.22+)"
            },
            "format": {
              "type": "string",
              "enum": ["text", "json", "yaml"],
              "description": "Output format override"
            },
            "mode": {
              "type": "string",
              "enum": ["overwrite", "append", "unique", "fail"],
              "description": "Write mode override"
            }
          }
        },
        {
          "type": "array",
          "description": "Multiple artifacts",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "source": { "type": "string" },
              "template": { "type": "string", "description": "Template string (v0.22+)" },
              "format": { "type": "string", "enum": ["text", "json", "yaml"] },
              "mode": { "type": "string", "enum": ["overwrite", "append", "unique", "fail"] }
            }
          }
        }
      ]
    },
    "LogConfig": {
      "type": "object",
      "description": "Logging configuration (v0.10+)",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"],
          "default": "info",
          "description": "Log level"
        },
        "format": {
          "type": "string",
          "enum": ["text", "json"],
          "default": "text",
          "description": "Log output format"
        },
        "console": {
          "type": "boolean",
          "default": true,
          "description": "Show logs in console output"
        },
        "file": {
          "type": "string",
          "description": "Log file path (supports {{context.meta.*}} templates)"
        }
      }
    },
    "AgentDef": {
      "type": "object",
      "description": "Reusable agent definition (v0.6+)",
      "properties": {
        "system": {
          "type": "string",
          "description": "System prompt (agent persona/behavior)"
        },
        "provider": {
          "type": "string",
          "enum": ["claude", "openai", "mistral", "groq", "deepseek", "gemini", "ollama", "mock"],
          "description": "Provider override"
        },
        "model": {
          "type": "string",
          "description": "Model override"
        },
        "mcp": {
          "type": "array",
          "items": { "type": "string" },
          "description": "MCP servers the agent can access"
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Builtin tools the agent can use"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skills to inject into agent"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Maximum agentic turns"
        },
        "depth_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum nested agent depth"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "LLM temperature"
        },
        "extended_thinking": {
          "type": "boolean",
          "default": false,
          "description": "Enable extended thinking (Claude only, v0.4+)"
        },
        "thinking_budget": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536,
          "default": 4096,
          "description": "Token budget for thinking"
        },
        "from": {
          "type": "string",
          "description": "Reference to another agent definition (v0.13+)"
        },
        "file": {
          "type": "string",
          "description": "External agent definition file (legacy, use from: instead)"
        }
      }
    }
  }
}
