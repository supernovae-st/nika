{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nika.dev/schemas/workflow.json",
  "title": "Nika Workflow",
  "description": "Schema for .nika.yaml workflow files - DAG workflow runner for AI tasks",
  "type": "object",
  "required": ["schema", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^nika/workflow@0\\.[1-9]$",
      "description": "Workflow schema version (nika/workflow@0.1 through @0.9)",
      "examples": ["nika/workflow@0.4", "nika/workflow@0.9"]
    },
    "workflow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Workflow identifier (lowercase alphanumeric with hyphens)",
      "examples": ["generate-page", "seo-pipeline"]
    },
    "description": {
      "type": "string",
      "description": "Human-readable workflow description"
    },
    "provider": {
      "type": "string",
      "enum": ["claude", "openai", "mistral", "groq", "deepseek", "gemini", "ollama", "mock"],
      "default": "claude",
      "description": "Default LLM provider for infer and agent tasks"
    },
    "model": {
      "type": "string",
      "description": "Default model override (e.g., claude-sonnet-4-6, gpt-4o)",
      "examples": ["claude-sonnet-4-6", "gpt-4o-mini", "gemini-2.0-flash"]
    },
    "context": {
      "$ref": "#/$defs/ContextSpec",
      "description": "File loading at workflow start (v0.9+)"
    },
    "include": {
      "type": "array",
      "description": "External workflows to merge into DAG (v0.9+)",
      "items": {
        "$ref": "#/$defs/IncludeSpec"
      }
    },
    "skills": {
      "type": "array",
      "description": "Workflow-level skills to inject (v0.15+)",
      "items": {
        "$ref": "#/$defs/SkillDef"
      }
    },
    "mcp": {
      "type": "object",
      "description": "MCP server configurations (v0.2+)",
      "additionalProperties": {
        "$ref": "#/$defs/McpServerConfig"
      }
    },
    "tasks": {
      "type": "array",
      "description": "List of tasks to execute",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Task"
      }
    },
    "flows": {
      "type": "array",
      "description": "DAG edges defining task dependencies",
      "items": {
        "$ref": "#/$defs/Flow"
      }
    }
  },
  "$defs": {
    "ContextSpec": {
      "type": "object",
      "description": "Context file loading configuration (v0.9+)",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "description": "File mappings (alias → path)",
          "additionalProperties": {
            "type": "string"
          },
          "examples": [{"brand": "./context/brand.md", "config": "./settings.json"}]
        },
        "session": {
          "type": "string",
          "description": "Session file path for state restoration"
        }
      }
    },
    "IncludeSpec": {
      "type": "object",
      "description": "External workflow to merge (v0.9+)",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to external .nika.yaml file"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Prefix for included task IDs (namespace isolation)"
        }
      }
    },
    "SkillDef": {
      "type": "object",
      "description": "Skill definition with path and optional alias (v0.15+)",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to skill file (local or pkg: URI)",
          "examples": ["./skills/writing.md", "pkg:@spn/core@1.0.0/skills/coding.md"]
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Alias for the skill"
        }
      }
    },
    "McpServerConfig": {
      "type": "object",
      "description": "Inline MCP server configuration",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "description": "Command to spawn the MCP server",
          "examples": ["cargo", "node", "python", "npx"]
        },
        "args": {
          "type": "array",
          "description": "Arguments to pass to the command",
          "items": { "type": "string" },
          "examples": [["run", "-p", "novanet-mcp"]]
        },
        "env": {
          "type": "object",
          "description": "Environment variables for the server process",
          "additionalProperties": { "type": "string" }
        },
        "cwd": {
          "type": "string",
          "description": "Working directory for the server process"
        }
      }
    },
    "Task": {
      "type": "object",
      "description": "A task in the workflow DAG",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique task identifier (lowercase alphanumeric with underscores/hyphens)"
        },
        "use": {
          "$ref": "#/$defs/WiringSpec",
          "description": "Data wiring from previous task outputs"
        },
        "output": {
          "$ref": "#/$defs/OutputPolicy",
          "description": "Output format and validation"
        },
        "for_each": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {}
            },
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-z0-9_]*$",
              "description": "Binding reference to an array (e.g., $locales)"
            },
            {
              "type": "string",
              "pattern": "^\\{\\{[^}]+\\}\\}$",
              "description": "Template binding expression (e.g., {{use.items}})"
            }
          ],
          "description": "Array to iterate over in parallel (v0.3+)"
        },
        "as": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "default": "item",
          "description": "Variable name for current iteration value"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1,
          "description": "Maximum parallel executions for for_each"
        },
        "fail_fast": {
          "type": "boolean",
          "default": true,
          "description": "Stop all iterations on first error"
        },
        "decompose": {
          "$ref": "#/$defs/DecomposeSpec",
          "description": "Runtime DAG expansion (v0.5+)"
        },
        "infer": {
          "$ref": "#/$defs/InferParams",
          "description": "LLM inference task"
        },
        "exec": {
          "$ref": "#/$defs/ExecParams",
          "description": "Shell command execution task"
        },
        "fetch": {
          "$ref": "#/$defs/FetchParams",
          "description": "HTTP request task"
        },
        "invoke": {
          "$ref": "#/$defs/InvokeParams",
          "description": "MCP tool call task (v0.2+)"
        },
        "agent": {
          "$ref": "#/$defs/AgentParams",
          "description": "Agentic execution task (v0.2+)"
        }
      },
      "oneOf": [
        { "required": ["id", "infer"] },
        { "required": ["id", "exec"] },
        { "required": ["id", "fetch"] },
        { "required": ["id", "invoke"] },
        { "required": ["id", "agent"] }
      ]
    },
    "DecomposeSpec": {
      "type": "object",
      "description": "Runtime DAG expansion via MCP traversal (v0.5+)",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["semantic", "static", "nested"],
          "description": "Expansion strategy"
        },
        "traverse": {
          "type": "string",
          "description": "Arc type to follow (for semantic strategy)"
        },
        "source": {
          "type": "string",
          "description": "Starting node reference (e.g., $entity)"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum items to expand"
        }
      }
    },
    "InferParams": {
      "oneOf": [
        {
          "type": "string",
          "description": "Simple prompt string (shorthand)"
        },
        {
          "type": "object",
          "required": ["prompt"],
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "description": "LLM prompt (supports {{use.alias}} templates)"
            },
            "provider": {
              "type": "string",
              "enum": ["claude", "openai", "mistral", "groq", "deepseek", "gemini", "ollama", "mock"],
              "description": "Provider override for this task"
            },
            "model": {
              "type": "string",
              "description": "Model override for this task"
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "LLM temperature (0.0-2.0, higher = more creative)"
            },
            "system": {
              "type": "string",
              "description": "System prompt (persona/behavior)"
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "description": "Maximum output tokens"
            }
          }
        }
      ]
    },
    "ExecParams": {
      "oneOf": [
        {
          "type": "string",
          "description": "Simple command string (shorthand)"
        },
        {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "description": "Shell command to execute (supports {{use.alias}} templates)"
            },
            "shell": {
              "type": "boolean",
              "default": false,
              "description": "Execute via shell (default: false for security, set true for pipes/redirects)"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "description": "Timeout in seconds"
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for command"
            }
          }
        }
      ]
    },
    "FetchParams": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to fetch"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
          "default": "GET",
          "description": "HTTP method"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "HTTP headers"
        },
        "body": {
          "type": "string",
          "description": "Request body (for POST/PUT/PATCH)"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Request timeout in seconds"
        }
      }
    },
    "InvokeParams": {
      "type": "object",
      "required": ["mcp"],
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "string",
          "description": "MCP server name (must match a key in workflow's mcp config)"
        },
        "tool": {
          "type": "string",
          "description": "Tool name to call (mutually exclusive with resource)"
        },
        "params": {
          "type": "object",
          "description": "Parameters to pass to the tool"
        },
        "resource": {
          "type": "string",
          "description": "Resource URI to read (mutually exclusive with tool)"
        }
      },
      "oneOf": [
        { "required": ["mcp", "tool"] },
        { "required": ["mcp", "resource"] }
      ]
    },
    "AgentParams": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "description": "User prompt for the agent"
        },
        "system": {
          "type": "string",
          "description": "System prompt (agent persona/behavior)"
        },
        "provider": {
          "type": "string",
          "enum": ["claude", "openai", "mistral", "groq", "deepseek", "gemini", "ollama", "mock"],
          "description": "Provider override"
        },
        "model": {
          "type": "string",
          "description": "Model override"
        },
        "mcp": {
          "type": "array",
          "items": { "type": "string" },
          "description": "MCP servers the agent can access"
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Builtin tools the agent can use (nika:read, nika:write, etc.)"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Maximum agentic turns"
        },
        "depth_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum nested agent depth (spawn_agent protection)"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "LLM temperature"
        },
        "extended_thinking": {
          "type": "boolean",
          "default": false,
          "description": "Enable extended thinking (Claude only)"
        },
        "thinking_budget": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536,
          "default": 8192,
          "description": "Token budget for extended thinking (Claude only)"
        },
        "stop_sequences": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sequences that stop generation"
        }
      }
    },
    "WiringSpec": {
      "type": "object",
      "description": "Data wiring from previous task outputs",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/WiringValue" }
        ]
      }
    },
    "WiringValue": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Source task.field reference (v0.5+ lazy bindings)"
        },
        "from": {
          "type": "string",
          "description": "Source task.field reference (legacy)"
        },
        "lazy": {
          "type": "boolean",
          "default": false,
          "description": "Defer resolution until first access (v0.5+)"
        },
        "default": {
          "description": "Default value if source is null"
        },
        "transform": {
          "type": "string",
          "enum": ["json", "yaml", "string", "trim"],
          "description": "Transform to apply"
        }
      }
    },
    "OutputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "yaml", "text", "markdown"],
          "default": "text",
          "description": "Expected output format"
        },
        "schema": {
          "type": "object",
          "description": "JSON Schema for output validation"
        },
        "save": {
          "type": "string",
          "description": "File path to save output"
        }
      }
    },
    "Flow": {
      "type": "object",
      "required": ["source", "target"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/FlowEndpoint",
          "description": "Source task(s)"
        },
        "target": {
          "$ref": "#/$defs/FlowEndpoint",
          "description": "Target task(s)"
        }
      }
    },
    "FlowEndpoint": {
      "oneOf": [
        {
          "type": "string",
          "description": "Single task ID"
        },
        {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Multiple task IDs"
        }
      ]
    }
  }
}
